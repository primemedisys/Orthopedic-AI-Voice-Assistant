APP_ENV=development

# ── Database ──
# Local development database (docker compose up -d db).
# Production uses the Amazon RDS URL, set only in the server's .env.
DATABASE_URL=postgresql+psycopg://appuser:localpass@localhost:5432/orthopedic_voice

# ── Public URL ──
# Public HTTPS URL of this app, with no trailing slash.
# Local: your ngrok URL. Production: https://voice.indiahealthsystem.com
PUBLIC_BASE_URL=https://YOUR-PUBLIC-URL
TELEPHONY_PROVIDER=plivo
DEFAULT_LANGUAGE=or

# ── Plivo ──
PLIVO_AUTH_ID=
PLIVO_AUTH_TOKEN=
# Your Plivo number in E.164 format, e.g. +91XXXXXXXXXX
PLIVO_NUMBER=
# Turn on after your first successful real call.
PLIVO_VALIDATE_SIGNATURE=false
PLIVO_SPEAK_VOICE=
PLIVO_SPEAK_LANGUAGE=

# ── Twilio (optional, only if TELEPHONY_PROVIDER=twilio) ──
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_NUMBER=
TWILIO_VALIDATE_SIGNATURE=false
TWILIO_VOICE=Polly.Aditi
SPEECH_LANGUAGE=en-IN

# ── Speech providers (sarvam or bodhan) ──
STT_PROVIDER=sarvam
TTS_PROVIDER=sarvam
TTS_CONCURRENCY=3

# ── Sarvam ──
SARVAM_API_BASE_URL=https://api.sarvam.ai
SARVAM_API_KEY=
SARVAM_STT_MODEL=saaras:v3
SARVAM_STT_MODE=codemix
SARVAM_STT_LANGUAGE=unknown
SARVAM_TTS_MODEL=bulbul:v3
SARVAM_TTS_SPEAKER=ritu
SARVAM_TTS_PACE=1.0
SARVAM_TTS_TEMPERATURE=0.6

# ── Bodhan (optional, only if a provider above is set to bodhan) ──
BODHAN_API_BASE_URL=https://api.bodhan.ai/v1
BODHAN_TRANSCRIBE_API_KEY=
BODHAN_SPEAK_API_KEY=
# Exact, case-sensitive voice name, e.g. Kavya
BODHAN_VOICE=
BODHAN_TTS_STYLE=
BODHAN_STT_LANGUAGE=

# ── Voice pipeline ──
VAD_RMS_THRESHOLD=450
VAD_END_SILENCE_MS=600
VAD_MIN_SPEECH_MS=300
VAD_MAX_UTTERANCE_S=25
BARGE_IN_MS=400
# true prints caller and bot speech in the logs. Testing only, keep false in production.
LOG_TRANSCRIPTS=false

# ── Latency ──
FILLER_ENABLED=true
FILLER_AFTER_MS=1500
FILLER_MIN_SPEECH_S=2.5
FILLER_MAX_PER_CALL=2
REPLY_MAX_TOKENS=220

# ── OpenAI ──
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini

# ── Clinic ──
DOCTOR_NAME=Dr. Pushpak Samal
# Number urgent calls are transferred to, E.164 format, e.g. +91XXXXXXXXXX
ESCALATION_PHONE=
BACKUP_PHONE=
TRANSFER_RING_SECONDS=25